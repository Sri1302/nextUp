# Copy to .env.local for local development, and add the same keys in Vercel → Settings → Environment Variables.
# Leave DATABASE_URL empty locally to use the built-in embedded database (data/pglite).

# Neon Postgres connection string (use the "pooled" one from the Neon dashboard)
DATABASE_URL=

# Public URL of the site, no trailing slash. e.g. https://nextup.vercel.app
APP_URL=http://localhost:3000

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta for Developers → your app → Instagram → API setup with Instagram login
# Use the *Instagram* app ID and secret. Redirect URI: <APP_URL>/auth/instagram/callback
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
